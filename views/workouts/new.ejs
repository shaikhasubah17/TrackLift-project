<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Workout</title>

    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <h1>Create a New Workout</h1>

    <form action="/workouts" method="POST">

        <div>
            <label for="workoutName">Workout Name</label><br>
            <input type="text" id="workoutName" name="workoutName" required > </div>

        <br>

        <div>
            <label for="category">Category</label><br>
            <select id="category" name="category" required>
                <option value="">Select a Category</option>
                <option value="Upper Body">Upper Body</option>
                <option value="Lower Body">Lower Body</option>
                <option value="HIIT">HIIT</option>
                <option value="Cardio">Cardio</option>
            </select>
        </div>

        <br>

        <div>
            <label for="experienceLevel">Experience Level</label><br>
            <select id="experienceLevel" name="experienceLevel" required>
                <option value="">Select Level</option>
                <option value="Beginner">Beginner</option>
                <option value="Intermediate">Intermediate</option>
                <option value="Advanced">Advanced</option>
             </select>
        </div>

        <br>

        <div>
            <label for="workoutEquipment">Equipment</label><br>
            <input type="text" id="workoutEquipment" name="workoutEquipment" placeholder="Example: Dumbbells" required >
        </div>

        <br>

        <div>
            <label for="workoutDuration">Duration (minutes)</label><br>
            <input type="number" id="workoutDuration" name="workoutDuration" min="1" required >
        </div>

        <br>

        <div>
            <label for="workoutRating">Rating (1-5)</label><br>
            <input type="number" id="workoutRating" name="workoutRating" min="1" max="5" >
        </div>

        <br>
        <button type="submit">Create Workout</button>
    </form>
    <br>
    <a href="/workouts">Back to My Workouts</a>

</body>
</html>