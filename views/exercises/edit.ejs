<!DOCTYPE html>
<html>
<head>
    <title>Edit Exercise</title>
</head>
<body>

<h1>Edit Exercise</h1>

<form action="/exercises/<%= exercise._id %>?_method=PUT" method="POST">

    <label>Exercise Name</label><br>
    <input type="text" name="exerciseName" value="<%= exercise.exerciseName %>" required>

    <br><br>

    <label>Sets</label><br>
    <input type="number" name="sets" value="<%= exercise.sets %>" required>

    <br><br>

    <label>Reps</label><br>
    <input type="number" name="reps" value="<%= exercise.reps %>" required>

    <br><br>

    <label>Weight (kg)</label><br>
    <input type="number" name="weight" value="<%= exercise.weight %>" required>

    <br><br>

    <button type="submit"> Update Exercise </button>

</form>

</body>
</html>